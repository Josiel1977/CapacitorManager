# Públicas — configurar em Development, Preview e Production
NEXT_PUBLIC_APP_URL=https://www.capacitormanager.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor — use SUPABASE_SECRET_KEY; o nome legado SERVICE_ROLE é aceito
SUPABASE_SECRET_KEY=

# Cobrança — somente servidor
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PLAN_BASICO=
MP_PLAN_ESSENCIAL=
MP_PLAN_PRO=
MP_PLAN_MASTER=

# Proteção contra abuso — mínimo de 32 caracteres aleatórios
RATE_LIMIT_SALT=

# Integrações opcionais — somente servidor
DEEPSEEK_API_KEY=

RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
